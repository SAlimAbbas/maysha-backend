APP_NAME=Maysha
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Database (Laragon / XAMPP / MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maysha_db
DB_USERNAME=root
DB_PASSWORD=

# Local Cache, Session, Queue (No Redis required for local development)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Redis (Uncomment when Redis/Memcached is installed)
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_CACHE_DB=1
# REDIS_PERSIST_DB=2

# Security & Reverse Proxies
TRUSTED_PROXIES=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# Cloudflare (Images / Stream / R2 / Turnstile)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_URL=https://imagedelivery.net/
CLOUDFLARE_STREAM_CUSTOMER_CODE=
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
TURNSTILE_SECRET=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="care@maysha.com"
MAIL_FROM_NAME="Maysha Skincare"

# Store Configuration Defaults
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=99

# Storefront ISR Revalidation
REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET=maysha_revalidate_secret

# Initial Admin Seeding
ADMIN_SEED_EMAIL=admin@maysha.com
ADMIN_SEED_PASSWORD=SecretPassword123!

# Google OAuth Socialite
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
